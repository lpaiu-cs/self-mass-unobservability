+      SUBROUTINE LINE_BOUNDS(LOW,HIGH,J1,J2)
+      INCLUDE 'PARAMS.FOR'
+      INCLUDE 'SYNTHP.FOR'
+      REAL*8 LOW,HIGH
+      INTEGER LFT,RGT,MID
+C     FREQ(3:NFREQ) is descending, with no uniform-grid assumption.
+      LFT=3
+      RGT=NFREQ+1
+   10 IF(LFT.LT.RGT) THEN
+         MID=(LFT+RGT)/2
+         IF(FREQ(MID).GT.HIGH) THEN
+            LFT=MID+1
+          ELSE
+            RGT=MID
+         END IF
+         GO TO 10
+      END IF
+      J1=LFT
+      LFT=3
+      RGT=NFREQ+1
+   20 IF(LFT.LT.RGT) THEN

% Cover letter for the Physical Review D submission. Fill in the bracketed items before submitting.
\documentclass[11pt]{article}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{lmodern}
\usepackage{microtype}
\usepackage[margin=0.8in]{geometry}
\usepackage{xcolor}

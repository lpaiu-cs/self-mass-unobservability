{"files": [{"id": 4253314, "name": "ct200438t_si_001.pdf", "size": 129029, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/4253314", "supplied_md5": "dfc5819c6bb1ed6da19c52cc3e063a4e", "computed_md5": "dfc5819c6bb1ed6da19c52cc3e063a4e", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 2161810, "full_name": "Jacek Komasa", "first_name": "Jacek", "last_name": "Komasa", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2161804, "full_name": "Konrad Piszczatowski", "first_name": "Konrad", "last_name": "Piszczatowski", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2161807, "full_name": "Grzegorz \u0141ach", "first_name": "Grzegorz", "last_name": "\u0141ach", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2161801, "full_name": "Micha\u0142 Przybytek", "first_name": "Micha\u0142", "last_name": "Przybytek", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2161798, "full_name": "Bogumi\u0142 Jeziorski", "first_name": "Bogumi\u0142", "last_name": "Jeziorski", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 2161813, "full_name": "Krzysztof Pachucki", "first_name": "Krzysztof", "last_name": "Pachucki", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Quantum_Electrodynamics_Effects_in_Rovibrational_Spectra_of_Molecular_Hydrogen/2604196", "download_disabled": false, "description": "The dissociation energies from all rovibrational levels of H<sub>2</sub> and D<sub>2</sub> in the ground electronic state are calculated\nwith high accuracy by including relativistic and quantum electrodynamics\n(QED) effects in the nonadiabatic treatment of the nuclear motion.\nFor D<sub>2</sub>, the obtained energies have theoretical uncertainties\nof 0.001 cm<sup>\u20131</sup>. For H<sub>2</sub>, similar uncertainties\nare for the lowest levels, while for the higher ones the uncertainty\nincreases to 0.005 cm<sup>\u20131</sup>. Very good agreement with\nrecent high-resolution measurements of the rotational <i>v</i> = 0 levels of H<sub>2</sub>, including states with large angular\nmomentum <i>J</i>, is achieved. This agreement would not\nhave been possible without accurate evaluation of the relativistic\nand QED contributions and may be viewed as the first observation of\nthe QED effects, mainly the electron self-energy, in a molecular spectrum.\nFor several electric quadrupole transitions, we still observe certain\ndisagreement with experimental results, which remains to be explained.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 129029, "created_date": "2016-02-22T22:07:18Z", "modified_date": "2023-06-20T05:18:51Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["Rovibrational Spectra", "cm", "Molecular HydrogenThe dissociation energies", "quantum electrodynamics", "quadrupole transitions", "momentum J", "quantum Electrodynamics Effects", "uncertainty increases", "0 levels", "rovibrational levels", "H 2", "QED contributions", "QED effects", "D 2", "nonadiabatic treatment"], "keywords": ["Rovibrational Spectra", "cm", "Molecular HydrogenThe dissociation energies", "quantum electrodynamics", "quadrupole transitions", "momentum J", "quantum Electrodynamics Effects", "uncertainty increases", "0 levels", "rovibrational levels", "H 2", "QED contributions", "QED effects", "D 2", "nonadiabatic treatment"], "categories": [{"id": 915, "title": "Physical Sciences not elsewhere classified", "parent_id": 6, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 19, "title": "Pharmacology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 133, "title": "Plant Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1021/ct200438t"], "has_linked_file": false, "citation": "Komasa, Jacek; Piszczatowski, Konrad; \u0141ach, Grzegorz; Przybytek, Micha\u0142; Jeziorski, Bogumi\u0142; Pachucki, Krzysztof (2016). Quantum Electrodynamics Effects in Rovibrational Spectra\nof Molecular Hydrogen. ACS Publications. Journal contribution. https://doi.org/10.1021/ct200438t.s001", "related_materials": [{"id": 97422903, "identifier": "10.1021/ct200438t", "title": "Quantum Electrodynamics Effects in Rovibrational Spectra\nof Molecular Hydrogen", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1021/ct200438t"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 2604196, "title": "Quantum Electrodynamics Effects in Rovibrational Spectra\nof Molecular Hydrogen", "doi": "10.1021/ct200438t.s001", "handle": "", "url": "https://api.figshare.com/v2/articles/2604196", "published_date": "2011-10-11T00:00:00Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-acs-4898564/4253314/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 2421, "url_private_api": "https://api.figshare.com/v2/account/articles/2604196", "url_public_api": "https://api.figshare.com/v2/articles/2604196", "url_private_html": "https://figshare.com/account/articles/2604196", "url_public_html": "https://acs.figshare.com/articles/journal_contribution/Quantum_Electrodynamics_Effects_in_Rovibrational_Spectra_of_Molecular_Hydrogen/2604196", "timeline": {"posted": "2011-10-11T00:00:00", "firstOnline": "2016-02-22"}, "resource_title": "Quantum Electrodynamics Effects in Rovibrational Spectra\nof Molecular Hydrogen", "resource_doi": "10.1021/ct200438t"}
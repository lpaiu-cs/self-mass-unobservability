# symbolic check of the free-fall closed form (phase 271): d2xi/dt2 = -c^2 (a^2/B^2) d/dr[alpha(phi0) dphi], alpha = -4 phi
t, r, c, D, eta, Rd, a, B, s = sp.symbols('t r c D eta R_d a B s', positive=True)

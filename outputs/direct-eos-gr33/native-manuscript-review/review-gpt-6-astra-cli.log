    u = np.asarray(tR) - Rd/C; out = np.empty(len(u))
    for i in range(0, len(u), 400):
        ph = om[None, :]*(u[i:i + 400, None] - ts); out[i:i + 400] = (np.cos(ph)*a_ + np.sin(ph)*b_) @ Qv
    return out

236: \frac{a_0}{2}\left[\frac{1}{1+s(\tau_0-\epsilon)}+\frac{1}{1+s(\tau_0+\epsilon)}\right]-\frac{a_0}{1+s\tau_0}
237: =\frac{a_0s^2\epsilon^2}{(1+s\tau_0)[(1+s\tau_0)^2-s^2\epsilon^2]}.
238: \label{eq:close-poles}
239: \end{equation}

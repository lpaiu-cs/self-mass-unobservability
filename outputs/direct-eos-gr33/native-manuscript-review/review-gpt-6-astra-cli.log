    Pg = g*m; rho = rho_from_Pg(Pg, T)
    hist = []
    for it in range(iters):
        ab, sc = opacity(rho, T); kR = rosseland(ab, sc, T)
        tauR = np.r_[0., np.cumsum(0.5*(kR[1:] + kR[:-1])*np.diff(m))] + kR[0]*m[0]

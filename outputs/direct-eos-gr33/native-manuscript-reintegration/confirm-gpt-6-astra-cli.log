  63: \mathcal Q_c(u)=\frac{1}{M_{\rm wd}}\sum_e w_e\,\frac{c}{2r_e}\int_{u-r_e/c}^{u+r_e/c}\delta M_e(t')\,dt',\qquad w=\alpha_s(\varphi_0)\,\mathcal N,
  64: \label{eq:wd-window}
  65: \end{equation}
